# ===== 前端依赖与构建产物 =====
node_modules/
frontend/node_modules/
frontend/dist/
# 依赖以 pnpm 管理（跟踪 pnpm-lock.yaml），npm 生成的锁文件勿入库
frontend/package-lock.json

# ===== Go 后端构建产物 =====
backend/web/dist/
backend/server.exe
backend/trmock.exe
backend/seedark
backend/seedark.exe

# ===== 开发服务器运行时产物（统一目录 dev/） =====
dev/

# ===== 运行时日志兜底（防止散落代码目录） =====
*.log

# ===== 本地配置（密钥类） =====
.env
.env.*
!.env.example
backend/.env
backend/.env.local
# 运行期状态文件明文保存各服务器凭据（SA_DATA_DIR 指向仓库时勿提交）
sa-state.json

# ===== IDE =====
.idea/
.vscode/
*.swp

# ===== 工具运行时产物（浏览器自动化调试输出，非源码） =====
.playwright-cli/
**/.playwright-cli/

# ===== OS =====
.DS_Store
Thumbs.db
backend/seedark-linux-arm64

# ===== TS 增量构建缓存 =====
*.tsbuildinfo
